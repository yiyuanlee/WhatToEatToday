/* pages/index/index.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF 100%);
  padding: 60rpx 40rpx;
  box-sizing: border-box;
}

/* Logo Area */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}

.logo-emoji {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}

.logo-text {
  font-size: 48rpx;
  font-weight: 700;
  color: #FF6B35;
  margin-bottom: 10rpx;
}

.logo-subtitle {
  font-size: 26rpx;
  color: #999;
}

/* Avatar Section */
.avatar-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
}

.avatar-wrapper {
  position: relative;
  width: 160rpx;
  height: 160rpx;
  margin-bottom: 30rpx;
}

.avatar-img {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  border: 6rpx solid #FFE4D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 100rpx;
  background: #FFF9F5;
}

.avatar-edit {
  position: absolute;
  bottom: 0;
  right: 0;
  background: #FF6B35;
  color: #fff;
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

.nickname-section {
  width: 100%;
  display: flex;
  justify-content: center;
}

.nickname-input {
  text-align: center;
  font-size: 32rpx;
  color: #333;
  border-bottom: 2rpx solid #FFE4D6;
  padding: 10rpx 20rpx;
  min-width: 200rpx;
}

.nickname-placeholder {
  color: #CCC;
}

/* Action Area */
.action-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 28rpx 80rpx;
  font-size: 34rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 53, 0.35);
  width: 100%;
  margin: 20rpx 0;
}

.btn-primary::after {
  border: none;
}

.btn-hover {
  opacity: 0.85;
  transform: scale(0.98);
}

.user-greeting {
  margin-top: 20rpx;
}

.greeting-text {
  font-size: 28rpx;
  color: #666;
}

/* Tips Area */
.tips-area {
  background: #FFF;
  border-radius: 20rpx;
  padding: 30rpx;
  width: 100%;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.04);
}

.tips-label {
  display: block;
  font-size: 26rpx;
  color: #FF6B35;
  font-weight: 600;
  margin-bottom: 10rpx;
}

.tips-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}