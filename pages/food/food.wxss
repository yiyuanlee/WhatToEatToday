/* pages/food/food.wxss */

.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FFF9F5 0%, #FFF 100%);
  padding: 40rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* Header */
.header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  width: 100%;
  margin-bottom: 40rpx;
}

.header-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #333;
}

.dice-wrapper {
  width: 80rpx;
  height: 80rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #FFF;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.dice {
  font-size: 50rpx;
}

@keyframes spin {
  0% { transform: rotate(0deg); }
  100% { transform: rotate(360deg); }
}

.spinning .dice {
  animation: spin 0.5s linear infinite;
}

/* Filter Scroll */
.filter-scroll {
  width: 100%;
  margin-bottom: 30rpx;
  white-space: nowrap;
}

.filter-list {
  display: inline-flex;
  gap: 16rpx;
  padding: 4rpx 0;
}

.filter-pill {
  display: inline-block;
  padding: 14rpx 32rpx;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #666;
  background: #FFF;
  border: 2rpx solid #FFE4D6;
  white-space: nowrap;
  flex-shrink: 0;
}

.filter-pill.active {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: #FFF;
  border-color: #FF6B35;
  font-weight: 600;
}

/* Result Card */
.result-card {
  background: #FFF;
  border-radius: 32rpx;
  padding: 60rpx 40rpx;
  width: 100%;
  box-shadow: 0 8rpx 40rpx rgba(255, 107, 53, 0.12);
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 40rpx;
  opacity: 0;
  transform: scale(0.9);
  transition: all 0.4s ease;
}

.result-card.show {
  opacity: 1;
  transform: scale(1);
}

.food-emoji {
  font-size: 140rpx;
  margin-bottom: 30rpx;
}

.food-name {
  font-size: 44rpx;
  font-weight: 700;
  color: #333;
  margin-bottom: 12rpx;
  text-align: center;
}

.food-category {
  font-size: 26rpx;
  color: #FF6B35;
  background: #FFF5F0;
  padding: 6rpx 24rpx;
  border-radius: 20rpx;
  margin-bottom: 24rpx;
}

.food-tags {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 24rpx;
}

.tag {
  font-size: 22rpx;
  color: #666;
  background: #F5F5F5;
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

.food-desc {
  font-size: 26rpx;
  color: #888;
  text-align: center;
  line-height: 1.6;
}

/* Action Area */
.action-area {
  width: 100%;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
  margin-bottom: 40rpx;
}

.btn-primary {
  background: linear-gradient(135deg, #FF6B35 0%, #F7931E 100%);
  color: #fff;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  border: none;
  box-shadow: 0 8rpx 30rpx rgba(255, 107, 53, 0.3);
}

.btn-primary::after {
  border: none;
}

.btn-secondary {
  background: #FFF;
  color: #FF6B35;
  border: 2rpx solid #FFE4D6;
  border-radius: 50rpx;
  padding: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.btn-secondary::after {
  border: none;
}

/* History */
.history-area {
  width: 100%;
  margin-top: auto;
}

.history-title {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}

.history-scroll {
  white-space: nowrap;
  width: 100%;
}

.history-list {
  display: inline-flex;
  gap: 20rpx;
  padding: 10rpx 0;
}

.history-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFF;
  padding: 20rpx 24rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 10rpx rgba(0, 0, 0, 0.05);
  min-width: 140rpx;
}

.history-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}

.history-name {
  font-size: 22rpx;
  color: #666;
  text-align: center;
}